{
  "__inputs": [],
  "__requires": [],
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "stat",
      "title": "Aktive Inserate",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "minibay_inserate_aktiv_total",
          "legendFormat": "Aktive Inserate"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "type": "stat",
      "title": "Inserate gesamt erstellt",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "minibay_inserate_erstellt_total",
          "legendFormat": "Erstellt gesamt"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "type": "stat",
      "title": "Fehlerquote (4xx/5xx)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "targets": [
        {
          "expr": "sum(rate(minibay_http_requests_total{status=~\"4..|5..\"}[1m]))",
          "legendFormat": "Fehler/s"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      }
    },
    {
      "type": "stat",
      "title": "Backend Status",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "targets": [
        {
          "expr": "up{job=\"minibay-backend\"}",
          "legendFormat": "UP/DOWN"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "mappings": [
          { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Requests pro Sekunde",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(minibay_http_requests_total[1m])) by (method)",
          "legendFormat": "{{ method }}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latenz p95 (Sekunden)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(minibay_http_request_duration_seconds_bucket[1m])) by (le, route))",
          "legendFormat": "p95 {{ route }}"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": ["minibay"],
  "time": { "from": "now-15m", "to": "now" },
  "title": "MiniBay Dashboard",
  "uid": "minibay-dashboard",
  "version": 1
}